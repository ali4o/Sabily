# ---------- server ----------
HOST=127.0.0.1
PORT=6767

# ---------- paths ----------
WORK_DIR=data
OUTPUTS_DIR=outputs
DB_PATH=data/sabily.db
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# ---------- ingest ----------
MAX_VIDEO_MINUTES=180
MAX_HEIGHT=1080
# COOKIES_FILE=D:/path/cookies.txt   # only if a source needs a login you own
# COOKIES_FROM_BROWSER=chrome        # chrome/edge/firefox — fixes most 403 refusals

# ---------- ASR (all local, after download) ----------
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=int8_float16
WHISPER_LANG=ar
WHISPER_PROMPT=          # optional initial prompt for Whisper (e.g. dialect hints)
# accuracy preset: fast (small model, beam 1) | balanced (= current) |
# accurate (large-v3 + context, slower, ~3GB download, fits 4GB VRAM)
WHISPER_ACCURACY=balanced
WHISPER_CONDITION=false  # true = use previous text as context (better flow, more repeats)
WHISPER_HOTWORDS=auto    # auto = bias glossary Latin terms | off | custom words
WHISPER_NO_SPEECH=0.6    # skip segments below this speech probability
WHISPER_LOGPROB=-1.0     # drop segments with worse avg log-probability
WHISPER_COMPRESSION=2.4  # drop repetitive/hallucinated segments above this ratio
VAD_MIN_SILENCE=400      # ms of silence that splits speech (higher = longer cuts)
VAD_SPEECH_PAD=400       # ms of audio kept around each speech chunk
VAD_MAX_SPEECH=0         # max seconds per VAD chunk, 0 = silero default

# ---------- clip selection ----------
CLIPS_PER_VIDEO=5
MIN_CLIP_SEC=20
MAX_CLIP_SEC=75
LLM_CANDIDATES=12
# moment engine: auto = detect per video (lecture|lesson|podcast|interview),
# each with its own metric weights. Override per job via content_type.
CONTENT_TYPE=auto

# ---------- LLM ----------
# ollama = local (default) | openai | gemini | none = heuristics only
LLM_PROVIDER=ollama
LLM_MODEL=gemma2:2b
OLLAMA_URL=http://localhost:11434
LLM_RERANK=true
LLM_TIMEOUT=180

# external API (used only when LLM_PROVIDER is openai/gemini)
LLM_API_KEY=
LLM_API_BASE=
# openai example: LLM_PROVIDER=openai  LLM_MODEL=gpt-4o-mini
# gemini example: LLM_PROVIDER=gemini  LLM_MODEL=gemini-2.0-flash

# ---------- render ----------
ASPECT=9:16
QUALITY=FHD                # HD (720p) | FHD (1080p, default) | QHD (2K 1440p)
TRANSCRIPT_POLISH=true     # LLM punctuation/spelling pass per clip (fallback: raw)
OUT_WIDTH=1080
OUT_HEIGHT=1920
DYNAMIC_CROP=true
# ---------- face tracking (all CPU, all local) ----------
FACE_SAMPLE_FPS=2.0      # frames analysed per second (higher = smoother, slower)
FACE_MIN_COVERAGE=0.25   # below this face share the whole frame is shown (blur fill)
FACE_HOLD_SEC=1.5        # bridge look-aways shorter than this (no flicker)
FACE_PROFILE=true        # second opinion for side faces (no new deps)
FACE_BLUR=40             # background blur strength for full-frame mode
FACE_CENTER_BIAS=0.3     # prefer centered faces 0..0.9 (posters sit at edges)
BURN_SUBTITLES=true
SUBTITLE_FONT=Cairo
CAPTION_LANG=ar
CRF=20
PRESET=veryfast
FONTS_DIR=assets/fonts
TERMS_FILE=assets/terms.json   # glossary for post-ASR fixes (auto-learned)
BRAND_WATERMARK=true
BRAND_TEXT=سبيلي
BRAND_POS=tr                   # tl|tc|tr|bl|bc|br
SOURCE_TAG=true
SOURCE_POS=tl                  # tl|tc|tr|bl|bc|br
KEEP_SOURCE=true               # keep work/ source for re-render; false frees disk

# ---------- subtitle style ----------
SUBTITLE_POS=bottom           # bottom|middle|top
SUBTITLE_STYLE=line           # line|karaoke (word-by-word highlight)
SPEAKER_LABELS=false          # prefix turns with المتحدث 1/2:
SUBTITLE_BILINGUAL=false      # second English line (needs LLM)
TURN_SEC=1.5                  # pause marking a speaker turn

# ---------- cards & motion (decorative, safe defaults) ----------
INTRO_CARD=false
OUTRO_CARD=false
ZOOM_PUNCH=false              # subtle zoom on tracked moves

# ---------- housekeeping ----------
CLEANUP_DAYS=0                # delete old work/ sources after N days, 0 = off

# ---------- quality ----------
INTRO_SEC=75          # opening stretch to avoid when picking clips
BEAM_SIZE=5           # 1 = fastest, 5 = fewer glued words
ENCODER=auto          # auto|nvenc|cpu
LOUDNORM=true         # match the -14 LUFS the platforms expect
